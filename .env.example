# ============================================================
# VARIABLES DE ENTORNO — BOOKINGSOFT (APARTAHOTEL FACILE)
# Copia este archivo a '.env' y completa con tus credenciales
# ============================================================

# Contenedor PostgreSQL
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=CHANGE_ME

# Conexión Backend -> Database (database/connection.py)
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_HOST=db
DB_PORT=5432
DB_NAME=CHANGE_ME

# Servidor Backend FastAPI (main.py)
PORT=4000
JWT_SECRET=CHANGE_ME

# Modos especiales de ejecución (Opcionales)
# DEMO_MODE: Si es 'true', activa el modo simulación en memoria sin requerir PostgreSQL.
DEMO_MODE=false
# RESET_DB: Si es 'true', elimina y recrea todas las tablas al reiniciar el backend (Solo desarrollo).
RESET_DB=false

