# ============================================================
# VARIABLES DE ENTORNO DE EJEMPLO — BOOKINGSOFT
# Copia este archivo como '.env' y completa con tus valores reales
# ============================================================

# Configuración del contenedor de PostgreSQL
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=your_postgres_db

# Configuración de conexión consumida por database/connection.py
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=db
DB_PORT=5432
DB_NAME=your_db_name

# Configuración del servidor Backend FastAPI consumida por main.py
PORT=4000
JWT_SECRET=your_jwt_secret_key_here
