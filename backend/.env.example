# ============================================================
# VARIABLES DE ENTORNO — BACKEND FASTAPI
# Copia este archivo a '.env' y reemplaza los valores de prueba
# ============================================================
PORT=4000
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_HOST=db
DB_PORT=5432
DB_NAME=CHANGE_ME
JWT_SECRET=CHANGE_ME

# Modos especiales de ejecución (Opcionales)

# RESET_DB: Si es 'true', elimina y recrea todas las tablas al reiniciar el backend (Solo desarrollo).
RESET_DB=false

# Configuración CORS (Orígenes permitidos separados por comas)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


